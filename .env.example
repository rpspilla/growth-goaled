# Copy to .env.local for local development. Never commit real values.

# Neon Postgres — pooled (app queries) and direct (migrations)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/growth_goaled?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/growth_goaled?sslmode=require

# Neon Auth (Managed Better Auth) — Auth URL from Neon Console → Better Auth → Project Info (per branch)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/growth_goaled/auth
# Signs session cookies; 32+ chars. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Public URL of this deployment. The STAGING badge shows when this is the dev domain.
APP_URL=http://localhost:3000

# Used from later milestones
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Resend: invite emails. Without a key, advisors get the invite link to share instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM="Growth Goaled <invites@growthgoaled.com>"

# Stripe: Single Assessment checkout (test keys on staging). Events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<app>/api/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Pricing (integer cents). The price shown is always the price charged.
ASSESSMENT_PRICE_CENTS=49900
# "From" price shown on the optional advisory offer
ADVISORY_PRICE_CENTS=75000
# Reserved for the future Growth Intelligence subscription; nothing is sold or shown yet
SUBSCRIPTION_PRICE_CENTS=29900
# Booking page for an executive advisor (https only, e.g. Calendly). Without it, founders send a request.
ADVISORY_BOOKING_URL=
# Optional separate booking page for the recommended monthly call (defaults to ADVISORY_BOOKING_URL)
ADVISORY_MONTHLY_BOOKING_URL=
# Optional: limit which assessments can be bought (comma-separated ids). Empty = all six.
SELLABLE_USE_CASES=
